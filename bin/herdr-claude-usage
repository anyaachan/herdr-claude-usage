#!/usr/bin/env bash
# herdr-claude-usage: global Claude Code plan usage inside Herdr.
#
# Data source: Claude Code invokes the configured statusLine command with a JSON
# payload on stdin that includes rate_limits (five_hour / seven_day / per-model
# windows, each with used_percentage and resets_at). `collect` captures that
# payload and chains to whatever statusLine command was installed before, so
# other consumers (e.g. herdr-agent-quota) keep working untouched.
set -u

HERDR=${HERDR_BIN_PATH:-herdr}
STATE_DIR=${HERDR_PLUGIN_STATE_DIR:-$HOME/.local/state/herdr/plugins/herdr-claude-usage}
CONFIG_DIR=${HERDR_PLUGIN_CONFIG_DIR:-$HOME/.config/herdr/plugins/config/herdr-claude-usage}
PAYLOAD="$STATE_DIR/payload.json"
CHAIN="$CONFIG_DIR/chain"
STALE_SECS=${STALE_SECS:-1800}

mkdir -p "$STATE_DIR"
[ -f "$CONFIG_DIR/config" ] && . "$CONFIG_DIR/config"

# ---------- collect: statusLine hook (invoked by Claude Code, not manually) ----------
# Usage limits are account-scoped, but different sessions may be signed into
# different accounts/organizations. Their reset timestamps differ, so payloads
# are clustered per (five_hour.resets_at, seven_day.resets_at) into profile
# files instead of clobbering one shared file.
collect() {
  local payload key sid
  payload=$(cat)
  if [ -n "$payload" ]; then
    printf '%s' "$payload" > "$PAYLOAD.tmp.$$" && mv "$PAYLOAD.tmp.$$" "$PAYLOAD"
    # Weekly reset is account-scoped and stable for a week, so it makes a good profile key.
    key=$(printf '%s' "$payload" | jq -r '(.rate_limits.seven_day.resets_at // .rate_limits.five_hour.resets_at // 0) | tostring' 2>/dev/null)
    if [ -n "$key" ] && [ "$key" != "0" ]; then
      mkdir -p "$STATE_DIR/profiles"
      local pfile="$STATE_DIR/profiles/$key.json" stored="$payload"
      # Claude Code sometimes omits five_hour from a payload. Keep the previous
      # window for this profile while it has not expired, so the 5h segment
      # does not flicker away whenever such a session writes last.
      if [ -s "$pfile" ]; then
        stored=$(printf '%s' "$payload" | jq --slurpfile old "$pfile" --argjson now "$(date +%s)" '
          if (.rate_limits.five_hour // null) == null
             and (($old[0].rate_limits.five_hour // null) != null)
             and ((($old[0].rate_limits.five_hour.resets_at // 0) | tonumber? // 0) > $now)
          then .rate_limits.five_hour = $old[0].rate_limits.five_hour
          else . end' 2>/dev/null) || stored="$payload"
        [ -n "$stored" ] || stored="$payload"
      fi
      printf '%s' "$stored" > "$pfile.tmp.$$" && mv "$pfile.tmp.$$" "$pfile"
      sid=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null)
      if [ -n "$sid" ]; then
        # Unique tmp per process: many sessions' statusLines run this concurrently.
        { grep -v "^$sid	" "$STATE_DIR/profiles/$key.sessions" 2>/dev/null; \
          printf '%s\t%s\t%s\n' "$sid" "$(date +%s)" \
            "$(printf '%s' "$payload" | jq -r '.cwd // "" | split("/") | last // ""' 2>/dev/null)"; } \
          > "$STATE_DIR/profiles/$key.sessions.tmp.$$" && mv "$STATE_DIR/profiles/$key.sessions.tmp.$$" "$STATE_DIR/profiles/$key.sessions"
      fi
    fi
  fi
  # Chain to the previous statusLine command, passing stdin and stdout through.
  if [ -f "$CHAIN" ]; then
    printf '%s' "$payload" | sh -c "$(cat "$CHAIN")"
  fi
}

# Fresh profiles ranked: most active sessions first, then most recently updated.
# Prints "payload_file<TAB>fresh_session_count<TAB>example_cwds" per profile.
profiles_ranked() {
  local now cutoff f s n names mtime
  now=$(date +%s); cutoff=$((now - STALE_SECS))
  for f in "$STATE_DIR"/profiles/*.json; do
    [ -f "$f" ] || continue
    mtime=$(stat -f %m "$f" 2>/dev/null || stat -c %Y "$f")
    [ "$mtime" -ge "$cutoff" ] || continue
    s="${f%.json}.sessions"
    n=0; names=""
    if [ -f "$s" ]; then
      n=$(awk -F'\t' -v c="$cutoff" '$2 >= c' "$s" | wc -l | tr -d ' ')
      names=$(awk -F'\t' -v c="$cutoff" '$2 >= c {print $3}' "$s" | sort -u | head -3 | paste -sd, -)
    fi
    printf '%s\t%s\t%s\t%s\n' "$n" "$mtime" "$f" "$names"
  done | sort -t$'\t' -k1,1nr -k2,2nr | awk -F'\t' '{print $3 "\t" $1 "\t" $4}'
}

# ---------- shared helpers ----------
payload_age() { # [file]
  local f="${1:-$PAYLOAD}"
  [ -f "$f" ] || { printf '%s' 999999; return; }
  printf '%s' $(( $(date +%s) - $(stat -f %m "$f" 2>/dev/null || stat -c %Y "$f") ))
}

# Portable epoch formatter: BSD date -r, GNU date -d @.
efmt() { date -r "$1" "$2" 2>/dev/null || date -d "@$1" "$2" 2>/dev/null; }

tz_name() {
  local link
  link=$(readlink /etc/localtime 2>/dev/null)
  case "$link" in
    *zoneinfo/*) printf '%s' "${link#*zoneinfo/}" ;;
    *) date +%Z ;;
  esac
}

# Sorted "key<TAB>used%<TAB>resets_epoch" lines, five_hour first, then seven_day, then the rest.
windows() {
  jq -r '
    (.rate_limits // .) | to_entries
    | map(select((.value | type) == "object" and ((.value.used_percentage // .value.utilization) != null)))
    | sort_by(if .key == "five_hour" then 0 elif .key == "seven_day" then 1 else 2 end)
    | .[] | [
        .key,
        ((.value.used_percentage // .value.utilization) | round | tostring),
        ((.value.resets_at // 0) as $r |
          (if ($r|type) == "number" then $r
           else (try (($r | sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601) + (if ($r | test("\\.[0-9]")) then 1 else 0 end)) catch 0)
           end) | tostring)
      ] | @tsv' "${1:-$PAYLOAD}" 2>/dev/null
}

# ---------- optional OAuth usage API (adds per-model weekly windows, e.g. Fable) ----------
# Reads the user's own Claude Code OAuth token from the macOS keychain (first use
# triggers a keychain permission prompt) and calls the official usage endpoint.
# The token stays in this process; only the usage JSON (no secrets) is cached.
API_CACHE="$STATE_DIR/api_usage.json"
USE_API=${USE_API:-1}

fetch_api() {
  [ "$USE_API" = "1" ] || return 0
  [ "$(payload_age "$API_CACHE")" -lt 300 ] && return 0
  [ "$(payload_age "$API_CACHE.failed")" -lt 300 ] && return 0
  command -v security >/dev/null 2>&1 || return 0
  local tok tmp="$API_CACHE.tmp.$$"
  tok=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null \
    | jq -r '.claudeAiOauth.accessToken // empty' 2>/dev/null)
  [ -n "$tok" ] || { : > "$API_CACHE.failed"; return 0; }
  if curl -sf -m 4 'https://api.anthropic.com/api/oauth/usage' \
       -H "Authorization: Bearer $tok" \
       -H 'anthropic-beta: oauth-2025-04-20' \
       -o "$tmp" 2>/dev/null \
     && jq -e 'type == "object"' "$tmp" >/dev/null 2>&1; then
    mv "$tmp" "$API_CACHE"
    rm -f "$API_CACHE.failed"
  else
    rm -f "$tmp"
    : > "$API_CACHE.failed"
  fi
}

# The profile whose weekly reset matches the API response IS the logged-in
# account; fall back to the busiest profile otherwise.
primary_file() { # ranked_list -> file
  local ranked="$1" api_wk="" file _n _names
  if [ -f "$API_CACHE" ]; then
    api_wk=$(windows "$API_CACHE" | awk -F'\t' '$1 == "seven_day" {print $3}')
  fi
  if [ -n "$api_wk" ] && [ "$api_wk" != "0" ]; then
    while IFS=$'\t' read -r file _n _names; do
      [ -n "$file" ] || continue
      # +/-2s tolerance: the API carries fractional seconds, the statusLine
      # payload whole seconds, so exact equality would never match.
      local wk; wk=$(windows "$file" | awk -F'\t' '$1 == "seven_day" {print $3}')
      if [ -n "$wk" ] && [ "$wk" -ge $((api_wk - 2)) ] && [ "$wk" -le $((api_wk + 2)) ] 2>/dev/null; then
        printf '%s' "$file"; return
      fi
    done <<< "$ranked"
  fi
  printf '%s' "$ranked" | head -1 | cut -f1
}

# Per-model windows from the API's structured limits array that the statusLine
# payload does not carry (e.g. the scoped Fable week). Emits "week:<Name>\tpct\tepoch".
api_extra_windows() {
  [ -f "$API_CACHE" ] || return 0
  [ "$(payload_age "$API_CACHE")" -lt 3600 ] || return 0
  jq -r '
    .limits[]?
    | select(.kind != "session" and .kind != "weekly_all" and .percent != null)
    | [
        ("week:" + (.scope.model.display_name // .scope.surface // .kind)),
        (.percent | round | tostring),
        ((.resets_at // "") as $r |
          (if ($r|type) == "number" then $r
           else (try (($r | sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601) + (if ($r | test("\\.[0-9]")) then 1 else 0 end)) catch 0)
           end) | tostring)
      ] | @tsv' "$API_CACHE" 2>/dev/null
}

# Monthly extra-usage credits: "pct\tused\tlimit\tcurrency" when enabled.
api_spend() {
  [ -f "$API_CACHE" ] || return 0
  [ "$(payload_age "$API_CACHE")" -lt 3600 ] || return 0
  jq -r '
    .spend? | select(.enabled == true and .percent != null)
    | [
        (.percent | round | tostring),
        ((.used.amount_minor / pow(10; .used.exponent)) | round | tostring),
        ((.limit.amount_minor / pow(10; .limit.exponent)) | round | tostring),
        (if .used.currency == "EUR" then "€" elif .used.currency == "USD" then "$" else .used.currency end)
      ] | @tsv' "$API_CACHE" 2>/dev/null
}

label_for() {
  case "$1" in
    five_hour) printf 'Session (5h)' ;;
    seven_day) printf 'Week · all models' ;;
    seven_day_*) local m="${1#seven_day_}"; printf 'Week · %s' "$(printf '%s' "${m:0:1}" | tr a-z A-Z)${m:1}" ;;
    week:*) printf 'Week · %s' "${1#week:}" ;;
    spend) printf 'Extra usage' ;;
    *) printf '%s' "$1" ;;
  esac
}

rel_time() { # epoch -> "2h04m" / "45m" / "2d3h"
  local d=$(( $1 - $(date +%s) )); [ "$d" -lt 0 ] && d=0
  if [ "$d" -ge 86400 ]; then printf '%dd%dh' $((d / 86400)) $((d % 86400 / 3600))
  elif [ "$d" -ge 3600 ]; then printf '%dh%02dm' $((d / 3600)) $((d % 3600 / 60))
  else printf '%dm' $((d / 60)); fi
}

abs_time() { # epoch -> "3pm" today, "Wed 6pm" otherwise
  if [ "$(efmt "$1" +%Y%m%d)" = "$(date +%Y%m%d)" ]; then
    efmt "$1" +%-I%p | tr 'A-Z' 'a-z'
  else
    printf '%s %s' "$(efmt "$1" +%a)" "$(efmt "$1" +%-I%p | tr 'A-Z' 'a-z')"
  fi
}

short_label() {
  case "$1" in
    five_hour) printf '5h' ;;
    seven_day) printf 'wk' ;;
    seven_day_*) local m="${1#seven_day_}"; printf '%s' "$(printf '%s' "${m:0:1}" | tr a-z A-Z)${m:1}" ;;
    week:*) printf '%s' "${1#week:}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# Tab-bar severity: "!!" after a percentage above BAR_HOT, nothing otherwise.
# (The tab bar renders no ANSI colors; BAR_WARN still drives the dashboard's
# amber bars.)
BAR_HOT=${BAR_HOT:-80}
BAR_WARN=${BAR_WARN:-50}
fmt_pct() {
  if [ "$1" -gt "$BAR_HOT" ] 2>/dev/null; then printf '%s%%!!' "$1"; else printf '%s%%' "$1"; fi
}

# ---------- bar: one-line summary for the Herdr tab bar ----------
# e.g.  ✳ 5h 24% ↻2am · wk 17% · Fable 13% · € 87%   (⁺ = another signed-in profile active)
bar() {
  fetch_api
  local ranked primary others
  ranked=$(profiles_ranked)
  primary=$(primary_file "$ranked")
  others=$(printf '%s\n' "$ranked" | grep -c . || true)
  [ -n "$primary" ] || { printf '✳ Claude —'; exit 0; }

  local parts=() key used epoch seg hr
  # No active 5h window means nothing used in it; say 0% rather than vanish.
  windows "$primary" | grep -q '^five_hour' || parts+=("5h 0%")
  while IFS=$'\t' read -r key used epoch; do
    seg="$(short_label "$key") $(fmt_pct "$used")"
    if [ "$key" = "five_hour" ] && [ "$epoch" -gt 0 ] 2>/dev/null; then
      hr=$(efmt "$epoch" +%-I%p | tr 'A-Z' 'a-z')
      [ -n "$hr" ] && seg="$seg ↻$hr"
    fi
    parts+=("$seg")
  done < <(windows "$primary")
  while IFS=$'\t' read -r key used epoch; do
    [ -n "$key" ] && parts+=("$(short_label "$key") $(fmt_pct "$used")")
  done < <(api_extra_windows)
  local pct _u _l cur
  while IFS=$'\t' read -r pct _u _l cur; do
    [ -n "$pct" ] && parts+=("${cur} $(fmt_pct "$pct")")
  done < <(api_spend)

  [ "${#parts[@]}" -gt 0 ] || { printf '✳ Claude —'; exit 0; }
  local out="✳ ${parts[0]}" i
  for ((i = 1; i < ${#parts[@]}; i++)); do out+=" · ${parts[$i]}"; done
  [ "$others" -gt 1 ] 2>/dev/null && out="$out ⁺"
  printf '%s' "$out"
}

# ---------- dashboard: pretty popup ----------
BAR_W=34
LINE_W=39   # bar + space + "100%"

draw_one() { # key used epoch [right-text]
  local key="$1" used="$2" epoch="$3" right="${4:-}"
  local dim=$'\e[2m' rst=$'\e[0m' bold=$'\e[1m'
  local label color filled tick i cells pad
  label=$(label_for "$key")
  if [ -z "$right" ] && [ "$epoch" -gt 0 ] 2>/dev/null; then
    right="↻ $(rel_time "$epoch") · $(abs_time "$epoch")"
  fi
  if [ "$used" -ge "$BAR_HOT" ] 2>/dev/null; then color=$'\e[38;5;210m'
  elif [ "$used" -ge "$BAR_WARN" ] 2>/dev/null; then color=$'\e[38;5;222m'
  else color=$'\e[38;5;147m'; fi
  filled=$(( used * BAR_W / 100 )); [ "$filled" -gt "$BAR_W" ] && filled=$BAR_W
  [ "$used" -gt 0 ] && [ "$filled" -eq 0 ] && filled=1
  # A faint tick marks where BAR_HOT begins.
  tick=$(( BAR_W * BAR_HOT / 100 )); [ "$tick" -ge "$BAR_W" ] && tick=$((BAR_W - 1))
  cells=""
  for ((i = 0; i < BAR_W; i++)); do
    if [ "$i" -lt "$filled" ]; then cells+="█"
    elif [ "$i" -eq "$tick" ]; then cells+=$'\e[38;5;243m'"┊${color}"
    else cells+=$'\e[38;5;238m'"░${color}"; fi
  done
  pad=$(( LINE_W - ${#label} - ${#right} )); [ "$pad" -lt 1 ] && pad=1
  printf '\n  %s%s%s%*s%s%s%s\n' "$bold" "$label" "$rst" "$pad" '' "$dim" "$right" "$rst"
  printf '  %s%s%s %3d%%\n' "$color" "$cells" "$rst" "$used"
}

draw_bars() { # payload_file
  local key used epoch
  while IFS=$'\t' read -r key used epoch; do
    draw_one "$key" "$used" "$epoch"
  done < <(windows "$1")
}

draw() {
  local dim=$'\e[2m' rst=$'\e[0m' bold=$'\e[1m'
  local tz ranked primary nsess age agetxt
  tz=$(tz_name)
  fetch_api
  ranked=$(profiles_ranked)
  primary=$(primary_file "$ranked")

  if [ -z "$primary" ]; then
    printf '\n  %s✳ Claude usage%s\n' "$bold" "$rst"
    printf '\n  %sNo fresh data. It appears within a minute of any Claude Code session running.%s\n' "$dim" "$rst"
    return
  fi

  age=$(payload_age "$primary")
  if [ "$age" -lt 120 ]; then agetxt="${age}s ago"
  else agetxt="$((age / 60))m ago"; fi
  nsess=$(printf '%s\n' "$ranked" | awk -F'\t' -v f="$primary" '$1 == f {print $2}')
  printf '\n  %s✳ Claude usage%s   %s%s · %s session(s) · %s%s\n' \
    "$bold" "$rst" "$dim" "$agetxt" "${nsess:-?}" "$tz" "$rst"
  windows "$primary" | grep -q '^five_hour' || draw_one five_hour 0 0
  draw_bars "$primary"

  # Per-model weekly windows only the usage API knows about (e.g. Fable).
  local key used epoch
  while IFS=$'\t' read -r key used epoch; do
    [ -n "$key" ] && draw_one "$key" "$used" "$epoch"
  done < <(api_extra_windows)

  # Monthly extra-usage credits.
  local pct spent limit cur
  while IFS=$'\t' read -r pct spent limit cur; do
    [ -n "$pct" ] && draw_one "spend" "$pct" 0 "${cur}${spent} of ${cur}${limit}"
  done < <(api_spend)

  # Other signed-in profiles, compact.
  local file n names5 line
  while IFS=$'\t' read -r file n names5; do
    [ "$file" = "$primary" ] && continue
    line=$(windows "$file" | awk -F'\t' '
      $1 == "five_hour" {s = $2} $1 == "seven_day" {w = $2}
      END {printf "5h %s%% · wk %s%%", (s == "" ? "?" : s), (w == "" ? "?" : w)}')
    printf '\n  %s◦ %s · other profile (%s session(s)%s)%s\n' "$dim" "$line" "$n" "${names5:+ · $names5}" "$rst"
  done < <(printf '%s\n' "$ranked")
}

dashboard() {
  while :; do
    printf '\e[H\e[2J'
    draw
    printf '\n  \e[2mq close · any key refresh · auto 30s\e[0m\n'
    read -r -s -t 30 -n 1 key 2>/dev/null && case "${key:-}" in q|Q|$'\e') break ;; esac
  done
}

# Write the tab-bar entry and dashboard keybinding into herdr's config.toml.
# Every added line carries a "# herdr-claude-usage" marker so uninstall can
# remove exactly what was added. Rolls back if herdr rejects the result.
herdr_config() {
  local cfg="${HERDR_CONFIG_PATH:-$HOME/.config/herdr/config.toml}" me tmp out
  me="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  [ -f "$cfg" ] || : > "$cfg"
  if grep -q 'herdr-claude-usage' "$cfg"; then
    echo "herdr config already references herdr-claude-usage; not touching $cfg"
    return
  fi
  cp "$cfg" "$cfg.bak-claude-usage"
  tmp="$cfg.tmp.$$"
  local bar_entry="{ type = \"command\", command = \"bash '$me' bar\", interval_seconds = 30, timeout_seconds = 5 }"
  local bar_line="tab_bar_right = [ $bar_entry ] # herdr-claude-usage"
  if grep -q '^[[:space:]]*tab_bar_right' "$cfg"; then
    echo "config already defines tab_bar_right; add this entry to it yourself:"
    echo "  $bar_entry"
    cp "$cfg" "$tmp"
  elif grep -q '^\[ui\][[:space:]]*$' "$cfg"; then
    awk -v line="$bar_line" '{print} /^\[ui\][[:space:]]*$/ && !done {print line; done=1}' "$cfg" > "$tmp"
  else
    { cat "$cfg"; printf '\n[ui] # herdr-claude-usage\n%s\n' "$bar_line"; } > "$tmp"
  fi
  {
    cat "$tmp"
    printf '\n[[keys.command]] # herdr-claude-usage\n'
    printf 'key = "prefix+u" # herdr-claude-usage\n'
    printf 'type = "popup" # herdr-claude-usage\n'
    printf 'command = "bash '\''%s'\'' dashboard" # herdr-claude-usage\n' "$me"
    printf 'description = "Claude usage dashboard" # herdr-claude-usage\n'
    printf 'width = 64 # herdr-claude-usage\n'
    printf 'height = 20 # herdr-claude-usage\n'
  } > "$tmp.2" && mv "$tmp.2" "$cfg" && rm -f "$tmp"
  out=$("$HERDR" server reload-config 2>/dev/null)
  if [ -z "$out" ]; then
    echo "herdr config updated (server not running; it loads on next start). Backup: $cfg.bak-claude-usage"
  elif [ "$(printf '%s' "$out" | jq -r '.result.diagnostics | length' 2>/dev/null)" = "0" ]; then
    echo "herdr config updated: tab-bar entry + prefix+u dashboard. Backup: $cfg.bak-claude-usage"
  else
    cp "$cfg.bak-claude-usage" "$cfg"
    "$HERDR" server reload-config >/dev/null 2>&1
    echo "herdr rejected the config change; backup restored. Add the entries manually (see README)."
  fi
}

herdr_config_remove() {
  local cfg="${HERDR_CONFIG_PATH:-$HOME/.config/herdr/config.toml}"
  if [ -f "$cfg" ] && grep -q '# herdr-claude-usage' "$cfg"; then
    grep -v '# herdr-claude-usage' "$cfg" > "$cfg.tmp.$$" && mv "$cfg.tmp.$$" "$cfg"
    "$HERDR" server reload-config >/dev/null 2>&1
    echo "removed herdr config entries"
  fi
}

# ---------- configure: install the statusLine wrapper (idempotent, reversible) ----------
configure() {
  local settings="$HOME/.claude/settings.json" me
  me="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  mkdir -p "$CONFIG_DIR"
  command -v jq >/dev/null || { echo "jq required"; exit 1; }
  local current
  current=$(jq -r '.statusLine.command // ""' "$settings" 2>/dev/null)
  case "$current" in
    *herdr-claude-usage*collect*) echo "statusLine wrapper already installed"; herdr_config; return ;;
  esac
  [ -n "$current" ] && printf '%s' "$current" > "$CHAIN" && echo "chaining to previous statusLine: $current"
  cp "$settings" "$settings.bak-claude-usage"
  jq --arg cmd "'$me' collect" '.statusLine = {type:"command", command:$cmd, refreshInterval:60}' \
    "$settings" > "$settings.tmp" && mv "$settings.tmp" "$settings"
  echo "statusLine wrapper installed (backup: $settings.bak-claude-usage)"
  herdr_config
}

uninstall() {
  local settings="$HOME/.claude/settings.json"
  if [ -f "$CHAIN" ]; then
    jq --arg cmd "$(cat "$CHAIN")" '.statusLine = {type:"command", command:$cmd, refreshInterval:60}' \
      "$settings" > "$settings.tmp" && mv "$settings.tmp" "$settings"
    echo "restored previous statusLine"
  else
    jq 'del(.statusLine)' "$settings" > "$settings.tmp" && mv "$settings.tmp" "$settings"
    echo "removed statusLine"
  fi
  herdr_config_remove
}

case "${1:-}" in
  collect) collect ;;
  bar) bar ;;
  dashboard) dashboard ;;
  draw) draw; printf '\n' ;;
  configure) configure ;;
  uninstall) uninstall ;;
  *) printf 'usage: herdr-claude-usage collect|bar|dashboard|draw|configure|uninstall\n' >&2; exit 2 ;;
esac
